node_modules/
.next/
dist/

# A cloned Site's own build output and lockfile-adjacent state.
sites/*/.next/
.turbo/
*.tsbuildinfo
.env
.env.local
.DS_Store

# Uploaded media, when a Site runs on the local disk rather than a bucket.
.media/

# Spec scratch state. The spec documents themselves are tracked — research and
# requirements are the record — but which one is active, and how far through it a
# run has got, are facts about a machine rather than about the project.
specs/.current-spec
**/.progress.md
**/.ralph-state.json

# Generated by Next on every dev or build, and differently by each: it points at
# .next/dev/types after `dev` and .next/types after `build`, so a tracked copy is
# a permanent uncommitted change that flips back and forth. Next's own docs say it
# should not be tracked.
starter/next-env.d.ts
sites/*/next-env.d.ts

# Orchestration state: logs, handoffs, session notepads. Project-scoped skills
# under .omc/skills/ are the deliberate exception and stay tracked.
.omc/
!.omc/skills/
