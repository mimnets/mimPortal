node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo
.env
.env.local
.DS_Store

# Uploaded media, when a Site runs on the local disk rather than a bucket.
.media/

# Spec scratch state. The spec documents themselves are tracked — research and
# requirements are the record — but which one is active, and how far through it a
# run has got, are facts about a machine rather than about the project.
specs/.current-spec
**/.progress.md

# Orchestration state: logs, handoffs, session notepads. Project-scoped skills
# under .omc/skills/ are the deliberate exception and stay tracked.
.omc/
!.omc/skills/
