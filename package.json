{
  "name": "mimnets",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript product for building websites you hand to clients",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "setup": "pnpm --filter starter run setup",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter starter db:generate",
    "db:migrate": "pnpm --filter starter db:migrate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "seed": "pnpm --filter starter run seed",
    "test": "vitest run",
    "build:packages": "turbo run build --filter='@mimnets/*'"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
