{
  "name": "@mimnets/admin",
  "version": "0.3.0",
  "description": "The Dashboard and the Editor",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/editor.css','dist/editor.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./editor.css": "./dist/editor.css"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mimnets/core": "workspace:*"
  },
  "devDependencies": {
    "@mimnets/blocks": "workspace:*",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "sideEffects": ["**/*.css"],
  "files": [
    "dist",
    "src"
  ]
}
