    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@mimnets/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "files": [
    "dist",
    "src"
  ]
}
