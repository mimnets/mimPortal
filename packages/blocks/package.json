{
  "name": "@mimnets/blocks",
  "version": "0.1.1",
  "description": "Standard Block Types",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
