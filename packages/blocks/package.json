{
  "name": "@mimnets/blocks",
  "version": "0.4.0",
  "description": "Standard Block Types",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./blocks.css": "./src/blocks.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/blocks.css','dist/blocks.css')\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./blocks.css": "./dist/blocks.css"
    }
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@mimnets/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ]
}
