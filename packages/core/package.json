{
  "name": "@mimnets/core",
  "version": "0.1.1",
  "description": "Layout schema, block registry, renderer and storage adapter",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./auth": "./src/auth/index.ts",
    "./storage": "./src/storage/index.ts",
    "./email": "./src/email/index.ts",
    "./forms": "./src/forms/index.ts",
    "./ai": "./src/ai/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./db": {
        "types": "./dist/db/index.d.ts",
        "default": "./dist/db/index.js"
      },
      "./auth": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "./storage": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      },
      "./email": {
        "types": "./dist/email/index.d.ts",
        "default": "./dist/email/index.js"
      },
      "./forms": {
        "types": "./dist/forms/index.d.ts",
        "default": "./dist/forms/index.js"
      },
      "./ai": {
        "types": "./dist/ai/index.d.ts",
        "default": "./dist/ai/index.js"
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "better-auth": "^1.6.29",
    "drizzle-orm": "^0.45.2",
    "markdown-it": "^15.0.1",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "files": [
    "dist",
    "src"
  ]
}
