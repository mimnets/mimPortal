# Every Site owns its own database (ADR-0001). Point this at that Site's database only.
#
# Local development (docker compose up -d db):
#   DATABASE_URL=postgres://mimnets:mimnets@localhost:5432/mimnets
#
# Neon (the default managed host, ADR-0009):
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this Site, used for auth callbacks.
BASE_URL=http://localhost:3000

# ---- Storage (ADR-0012) -----------------------------------------------------
#
# Uploaded images go to the Site's own disk unless a bucket is configured. Nothing here
# needs setting to accept an upload — this is the part you change before a Site goes
# anywhere real, because a disk belongs to the machine it is on.

# Where uploads live on disk. Relative paths resolve against the app's working directory.
# Keep this outside the deploy directory, or mount it as a volume, or both.
# MEDIA_DIR=.media

# An S3-compatible bucket instead: Cloudflare R2, Amazon S3, MinIO, Backblaze B2.
# All four must be set together, or the Site refuses to start rather than half-working.
#
#   S3_BUCKET=my-site-media
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=

# R2 ignores the region but still signs with one. Leave unset for R2; set it for S3.
# S3_REGION=auto

# The public domain objects are served from — an R2 custom domain, or a CDN. Without it the
# bucket stays private and the Site proxies reads through its own /media route.
# S3_PUBLIC_BASE_URL=https://media.example.com

# ---- Email (docs/EMAIL.md) --------------------------------------------------
#
# Contact-form notifications and password resets. Nothing here needs setting for the form to
# work: every enquiry is stored and read in the Dashboard whether or not mail is configured.
# Set one of the two options below to be told when one arrives.
#
# Full setup instructions, including the DNS records Resend needs, are in docs/EMAIL.md.

# Option 1 — Resend. Needs an account and a verified sending domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option 2 — SMTP. Any mailbox that allows SMTP sending. Use an app password, not the
# account password. Port 465 is implicit TLS; 587 upgrades with STARTTLS.
# SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=465
# SMTP_USER=hello@example.com
# SMTP_PASSWORD=
# SMTP_SECURE=            # only if your provider does something unusual with TLS

# Required by both. Resend rejects a From address outside the verified domain, and most SMTP
# servers reject one the authenticated account does not own.
# EMAIL_FROM="Acme <hello@acme.com>"

# Where enquiries go when a contact Block does not name its own address.
# CONTACT_RECIPIENT=enquiries@acme.com

# ---- The AI assistant (docs/AI.md) ------------------------------------------
#
# Rewrite, shorten, proofread, alt text and search descriptions, inside the Editor. Off until
# at least one provider is set — the buttons do not appear at all until then.
#
# Providers are tried in order: free first, paid after (ADR-0014). One OpenRouter key is
# enough to get a working assistant with no card on file.

# OpenRouter. Free tier needs no payment method.
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter retires free models regularly. Override the built-in list when they stop working
# — see https://openrouter.ai/models?max_price=0
# AI_FREE_MODELS=deepseek/deepseek-chat-v3.1:free,meta-llama/llama-3.3-70b-instruct:free

# A paid OpenRouter model, tried after the free ones.
# AI_OPENROUTER_MODEL=anthropic/claude-opus-4.5

# Paid fallbacks. Any, all, or none — each is tried in this order.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-proj-...
# AI_OPENAI_MODEL=gpt-5
# DEEPSEEK_API_KEY=sk-...
# AI_DEEPSEEK_MODEL=deepseek-chat

# Per signed-in person, per minute. A cost guard, not a security control.
# AI_REQUESTS_PER_MINUTE=20

# Run the tests that call a real model. Off by default: free models are rate limited and
# retired without notice, so they fail for reasons unrelated to the code. Turn this on before
# shipping a change to the AI stack — `AI_LIVE_TESTS=1 pnpm test`.
# AI_LIVE_TESTS=1

# Your own endpoint, in either wire format — a self-hosted model, a gateway, Together, Groq,
# or Azure OpenAI. Tried before the named vendors below.
# AI_CUSTOM_BASE_URL=https://your-endpoint.example/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_MODEL=
# AI_CUSTOM_FORMAT=openai        # "openai" or "anthropic"
# AI_CUSTOM_NAME=Our gateway     # what it is called in the Dashboard

# ---- Stock photographs -------------------------------------------------------
#
# Optional. Without a key, applying a generated Preset leaves its image fields
# empty exactly as it did before this existed — the descriptions the Preset wrote
# stay in each field's alt text, so an Author knows what belongs there.
#
# With one, photographs are searched for, downloaded into this Site's own media
# store and recorded with their photographer. They are never hotlinked: a layout
# holds a storage key, never a URL (ADR-0012).
#
# Unsplash is preferred when both are set, because it is the one whose terms this
# Site can fully satisfy — it reports uses back, which Unsplash requires.
#
# Full setup, and what each licence asks of you, is in docs/STOCK.md.

# UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
