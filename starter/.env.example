# Every Site owns its own database (ADR-0001). Point this at that Site's database only.
#
# Local development (docker compose up -d db):
#   DATABASE_URL=postgres://mimnets:mimnets@localhost:5432/mimnets
#
# Neon (the default managed host, ADR-0009):
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Session signing secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this Site, used for auth callbacks.
BASE_URL=http://localhost:3000

# ---- Storage (ADR-0012) -----------------------------------------------------
#
# Uploaded images go to the Site's own disk unless a bucket is configured. Nothing here
# needs setting to accept an upload — this is the part you change before a Site goes
# anywhere real, because a disk belongs to the machine it is on.

# Where uploads live on disk. Relative paths resolve against the app's working directory.
# Keep this outside the deploy directory, or mount it as a volume, or both.
# MEDIA_DIR=.media

# An S3-compatible bucket instead: Cloudflare R2, Amazon S3, MinIO, Backblaze B2.
# All four must be set together, or the Site refuses to start rather than half-working.
#
#   S3_BUCKET=my-site-media
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=

# R2 ignores the region but still signs with one. Leave unset for R2; set it for S3.
# S3_REGION=auto

# The public domain objects are served from — an R2 custom domain, or a CDN. Without it the
# bucket stays private and the Site proxies reads through its own /media route.
# S3_PUBLIC_BASE_URL=https://media.example.com
